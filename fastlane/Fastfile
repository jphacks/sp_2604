require "cgi"
require "json"
require "net/http"

default_platform(:ios)

# 署名するターゲットと Bundle ID の対応。Apple Watch アプリと Widget は iPhone アプリに同梱して配布する。
APP_TARGETS = {
  "Dareda" => "com.kantacky.Dareda",
  "DaredaWatch" => "com.kantacky.Dareda.watchkitapp",
  "DaredaWidget" => "com.kantacky.Dareda.Widget",
}.freeze

PROJECT_FILE = "App/Dareda.xcodeproj/project.xcproj"

platform :ios do
  # readonly の match は Git リポジトリから取得するだけなので API Key は不要。
  # 書き込みを伴うレーンでだけ API Key を読み込む。
  private_lane :load_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT_BASE64"),
      is_key_content_base64: true,
    )
  end

  # match はプロファイルを作れても App ID は作らないため、未登録の Bundle ID を先に登録する
  private_lane :register_bundle_ids do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY])
    APP_TARGETS.each do |target, identifier|
      next if Spaceship::ConnectAPI::BundleId.find(identifier)

      UI.message("Bundle ID #{identifier} を登録します")
      Spaceship::ConnectAPI::BundleId.create(
        name: target,
        identifier: identifier,
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
      )
    end
  end

  desc "証明書とプロファイルを取得する (読み取り専用)"
  lane :certificates do
    %w[development adhoc appstore].each do |type|
      match(type: type, readonly: true)
    end
  end

  desc "Bundle ID を登録し、証明書とプロファイルを作成・更新して保存する"
  lane :renew_certificates do
    load_api_key
    register_bundle_ids
    %w[development adhoc appstore].each do |type|
      match(type: type, readonly: false)
    end
  end

  desc "デバイスを登録して Development・Ad Hoc プロファイルを更新する (name: 名前, udid: UDID)"
  lane :add_device do |options|
    load_api_key
    register_bundle_ids
    register_devices(devices: { options.fetch(:name) => options.fetch(:udid) })
    %w[development adhoc].each do |type|
      match(type: type, readonly: false)
    end
  end

  desc "Ad Hoc ビルドを Firebase App Distribution にアップロードし、developers グループに配信する"
  lane :distribute do
    setup_ci
    # GitHub App のインストールトークンを Basic 認証 (x-access-token:<token>) の形にする
    ENV["MATCH_GIT_BASIC_AUTHORIZATION"] = Base64.strict_encode64("x-access-token:#{ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION")}")
    match(type: "adhoc", readonly: true)

    # project.xcproj 形式は xcodeproj gem (update_code_signing_settings) で読めないため、
    # Development プロファイルの指定を Ad Hoc のものに直接書き換える
    project_path = File.expand_path("../#{PROJECT_FILE}", __dir__)
    project = File.read(project_path)
    profile_names = APP_TARGETS.values.to_h do |identifier|
      profile_name = ENV.fetch("sigh_#{identifier}_adhoc_profile-name")
      project = project.gsub("\"match Development #{identifier}\"", "\"#{profile_name}\"")
      [identifier, profile_name]
    end
    File.write(project_path, project)

    build_number = ENV.fetch("GITHUB_RUN_NUMBER")
    build_app(
      workspace: "Dareda.xcworkspace",
      scheme: "Dareda",
      configuration: "Release",
      export_method: "ad-hoc",
      export_options: {
        provisioningProfiles: profile_names,
      },
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} CODE_SIGN_IDENTITY='Apple Distribution' -skipMacroValidation -skipPackagePluginValidation",
      output_directory: "build",
      output_name: "Dareda.ipa",
    )

    # 認証は Application Default Credentials (google-github-actions/auth が設定) を使う
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      groups: "developers",
      release_notes: ENV.fetch("RELEASE_NOTES", ""),
    )

    notify_slack(
      release: lane_context[SharedValues::FIREBASE_APP_DISTRO_RELEASE],
      build_number: build_number,
    )
  end

  # 配信結果を Slack の Incoming Webhook に Block Kit で送信する
  private_lane :notify_slack do |options|
    release = options.fetch(:release) || {}
    install_url = release["testingUri"]
    sha = ENV.fetch("GITHUB_SHA")
    commit_url = "#{ENV.fetch("GITHUB_SERVER_URL")}/#{ENV.fetch("GITHUB_REPOSITORY")}/commit/#{sha}"
    message = sh("git log -1 --pretty=%B #{sha}", log: false).strip
    escape = ->(text) { text.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;") }

    blocks = [
      { type: "header", text: { type: "plain_text", text: "Dareda を配信しました" } },
      {
        type: "section",
        fields: [
          { type: "mrkdwn", text: "*バージョン*\n#{release["displayVersion"] || File.read(File.expand_path("../#{PROJECT_FILE}", __dir__))[/"MARKETING_VERSION": "([^"]+)"/, 1]}" },
          { type: "mrkdwn", text: "*ビルド番号*\n#{release["buildVersion"] || options.fetch(:build_number)}" },
          { type: "mrkdwn", text: "*コミット*\n<#{commit_url}|`#{sha[0, 7]}`>" },
        ],
      },
      { type: "section", text: { type: "mrkdwn", text: "*コミットメッセージ*\n#{escape.call(message)[0, 2800]}" } },
    ]

    if install_url
      blocks << {
        type: "section",
        text: { type: "mrkdwn", text: "<#{install_url}|インストールはこちら>" },
        accessory: {
          type: "image",
          image_url: "https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=#{CGI.escape(install_url)}",
          alt_text: "インストールリンクの QR コード",
        },
      }
    end

    uri = URI(ENV.fetch("SLACK_WEBHOOK_URL"))
    response = Net::HTTP.post(uri, { blocks: blocks, text: "Dareda を配信しました" }.to_json, "Content-Type" => "application/json")
    UI.user_error!("Slack への送信に失敗しました: #{response.code} #{response.body}") unless response.is_a?(Net::HTTPSuccess)
  end
end
